  <!-- EN: Buddhist origin -->
  <Structure_OriginBuddhist.label>佛教源流</Structure_OriginBuddhist.label>
  <!-- EN: This ideoligion is a descendant of ancient Buddhism. It may have very different precepts than those of thousands of years ago, but its symbols are similar. -->
  <Structure_OriginBuddhist.description>此理念源自古佛教。它的戒律可能与数千年前大不相同，但符号相似。</Structure_OriginBuddhist.description>
  <!-- EN: pagoda -->
  <Structure_OriginBuddhist.worshipRoomLabel>佛塔</Structure_OriginBuddhist.worshipRoomLabel>

